  "source": "// SPDX-License-Identifier: MIT\r\npragma solidity >=0.4.22 <0.9.0;\r\n\r\nlibrary StatusLib {\r\n    struct StatusHistory {\r\n        uint status;\r\n        uint256 timestamp;\r\n    }\r\n\r\n    function addStatus(\r\n        StatusHistory[] storage history,\r\n        uint status\r\n    ) internal {\r\n        history.push(StatusHistory(status, block.timestamp));\r\n    }\r\n}",
